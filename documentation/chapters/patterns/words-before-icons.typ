#import "../../template.typ": pattern-page, pat-ref

#pattern-page(
  title: [Words Before Icons],
  stars: 1,
  description: (
    [Der Benutzer soll wählen können, ob Icons durch aussagekräftigere Texte auf der Webseite ersetzt werden sollen. Generell sollen textuelle Beschriftungen immer primär behandeln und Icons nur als visuelle Ergänzung einsetzen werden. Zudem soll sichergestellt werden, dass Icons einen Alt Text haben, um verwirrende Semantische Bedeutungen, die von Unicode Icons vorgelesen werden, zu vermeiden.],
  ),
  related-patterns: (),
  wcag-intro: "Related WCAG success criteria",
  wcag: (
    [Success Criterion 1.1.1 Non-text Content (Level A)],
  ),
)
